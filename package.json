{
  "name": "laddorious",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/bots && tsc -p packages/host && tsc -p apps/sim && tsc -p apps/server && tsc -p apps/server/test && tsc -p apps/client && tsc -p apps/client/e2e",
    "lint": "eslint .",
    "sim": "tsx apps/sim/src/bin.ts",
    "dev": "pnpm --filter @laddorious/client dev",
    "build": "pnpm --filter @laddorious/client build",
    "e2e": "pnpm --filter @laddorious/client e2e"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.23.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
